              "name": "HarmfulExecution",
              "shortDescription": {
                "text": "信頼できない入力が実行に届く道（確認なしの道具だけで成り立つ）"
              },
              "fullDescription": {
                "text": "信頼できない入力が実行に届く道（確認なしの道具だけで成り立つ）"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SKP-ACT",
              "name": "IrreversibleAction",
              "shortDescription": {
                "text": "信頼できない入力が取り返しのつかない操作に届く道"
              },
              "fullDescription": {
                "text": "信頼できない入力が取り返しのつかない操作に届く道"
              },
              "defaultConfiguration": {
                "level": "error"
              }
