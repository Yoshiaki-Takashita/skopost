{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(npm run *)", "Read", "mcp__github__get_issue", "WebFetch(domain:example.com)"],
    "ask": ["Bash(git push *)", "Write"],
    "deny": ["WebSearch", "Read(./.env)", "Bash(*)", "mcp__github__delete(x)"],
    "defaultMode": "default",
    "futureKey": 1
  },
  "env": {"LOG": "1"},
  "hooks": {"PreToolUse": []},
  "model": "opus"
}
