{
  "mcpServers": {
    "vault": {
      "command": "uvx",
      "args": [
        "./servers/vault/main"
      ],
      "tools": [
        {
          "name": "get_secret",
          "description": "Read a named credential from the local vault.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            }
          },
          "annotations": {
            "readOnlyHint": true,
            "openWorldHint": false
          }
        }
      ],
      "timeoutMs": "x"
    },
    "shell": {
      "command": "python3",
      "args": [
        "./servers/shell/main"
      ],
      "tools": [
        {
          "name": "run_command",
          "description": "Run a shell command in the project directory.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              }
            }
          },
          "annotations": {
            "readOnlyHint": false,
            "openWorldHint": false,
            "destructiveHint": true
          }
        }
      ]
    }
  }
}
