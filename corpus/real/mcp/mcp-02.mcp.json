{
  "mcpServers": {
    "tickets": {
      "command": "python3",
      "args": [
        "./servers/tickets/main"
      ],
      "tools": [
        {
          "name": "post_comment",
          "description": "Post a public comment on a ticket.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "ticket": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "payments": {
      "type": "http",
      "url": "https://payments.example.com/mcp",
      "tools": [
        {
          "name": "refund_payment",
          "description": "Refund a payment to the customer.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "payment": {
                "type": "string"
              },
              "amount": {
                "type": "string"
              }
            }
          }
        },
        {
          "name": "list_invoices",
          "description": "List invoices for the account.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "web": {
      "type": "sse",
      "url": "http://localhost:7705/mcp",
      "tools": [
        {
          "name": "search_web",
          "description": "Search the web and return result snippets.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              }
            }
          },
          "annotations": {
            "readOnlyHint": true,
            "openWorldHint": true
          }
        },
        {
          "name": "fetch_page",
          "description": "Fetch a web page and return its text.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "shell": {
      "type": "http",
      "url": "https://mcp.example.org/shell",
      "tools": [
        {
          "name": "run_command",
          "description": "Run a shell command in the project directory.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              }
            }
          },
          "annotations": {
            "readOnlyHint": false,
            "openWorldHint": false,
            "destructiveHint": true
          }
        }
      ]
    }
  }
}
