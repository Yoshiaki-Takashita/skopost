{
  "openapi": "3.0.1",
  "info": {
    "title": "Synthetic vault API",
    "version": "9"
  },
  "servers": [
    {
      "url": "https://vault.example.org/v1"
    }
  ],
  "paths": {
    "/secret": {
      "get": {
        "operationId": "get_secret",
        "summary": "Read a named credential from the local vault.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/event": {
      "post": {
        "operationId": "create_event",
        "summary": "Create a calendar event and invite attendees.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "attendees": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/file": {
      "get": {
        "operationId": "read_file",
        "summary": "Read a file from the workspace.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/command/{id}": {
      "post": {
        "operationId": "run_command",
        "summary": "Run a shell command in the project directory.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  }
}
