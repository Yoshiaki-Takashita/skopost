{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic payments API",
    "version": "4"
  },
  "paths": {
    "/invoices": {
      "get": {
        "operationId": "list_invoices",
        "summary": "List invoices for the account.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/payment/{id}": {
      "delete": {
        "operationId": "refund_payment",
        "summary": "Refund a payment to the customer.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payment": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "x-internal": true
      }
    },
    "/file/{id}": {
      "delete": {
        "operationId": "write_file",
        "summary": "Write text to a file in the workspace.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "visibility": "x"
    },
    "/table/{id}": {
      "post": {
        "operationId": "drop_table",
        "summary": "Drop a database table.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "table": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/db": {
      "get": {
        "operationId": "query_db",
        "summary": "Run a read-only SQL query.",
        "parameters": [
          {
            "name": "sql",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    }
