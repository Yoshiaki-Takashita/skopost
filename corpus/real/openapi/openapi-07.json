{
  "openapi": "3.0.1",
  "info": {
    "title": "Synthetic shell API",
    "version": "6"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/command/{id}": {
      "post": {
        "operationId": "run_command",
        "summary": "Run a shell command in the project directory.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "x-internal": true
      }
    },
    "/push": {
      "post": {
        "operationId": "git_push",
        "summary": "Push the current branch to the remote.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "remote": {
                    "type": "string"
                  },
                  "branch": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/invoices": {
      "get": {
        "operationId": "list_invoices",
        "summary": "List invoices for the account.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "x-team": "corpus"
    },
    "/tickets": {
      "get": {
        "operationId": "search_tickets",
        "summary": "Search support tickets.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  }
}
