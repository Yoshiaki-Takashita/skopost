  "paths": {
    "/db": {
      "get": {
        "operationId": "query_db",
        "summary": "Run a read-only SQL query.",
        "parameters": [
          {
            "name": "sql",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/table/{id}": {
      "post": {
        "operationId": "drop_table",
        "summary": "Drop a database table.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "table": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/file": {
      "get": {
        "operationId": "read_file",
        "summary": "Read a file from the workspace.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/message": {
      "post": {
        "operationId": "send_message",
