    "/secret": {
      "get": {
        "operationId": "get_secret",
        "summary": "Read a named credential from the local vault.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
