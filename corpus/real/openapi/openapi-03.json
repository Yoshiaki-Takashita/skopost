{
  "openapi": "3.0.3",
  "info": {
    "title": "Synthetic files API",
    "version": "6"
  },
  "servers": [
    {
      "url": "https://files.example.org/v1"
    }
  ],
  "paths": {
    "/file": {
      "get": {
        "operationId": "read_file",
        "summary": "Read a file from the workspace.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/file/{id}": {
      "delete": {
        "operationId": "write_file",
        "summary": "Write text to a file in the workspace.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "x-internal": true
      }
    },
    "/dir": {
      "get": {
        "operationId": "list_dir",
        "summary": "List entries of a directory.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "list_events",
        "summary": "List calendar events in a range.",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "x-team": "corpus"
    },
    "/event": {
      "post": {
        "operationId": "create_event",
        "summary": "Create a calendar event and invite attendees.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "attendees": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/note": {
      "post": {
        "operationId": "create_note",
        "summary": "Create a new note.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  }
}
