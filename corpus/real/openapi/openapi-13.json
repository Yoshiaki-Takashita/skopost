{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic tickets API",
    "version": "4"
  },
  "paths": {
    "/tickets": {
      "get": {
        "operationId": "search_tickets",
        "summary": "Search support tickets.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/comment": {
      "post": {
        "operationId": "post_comment",
        "summary": "Post a public comment on a ticket.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ticket": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "owner": "x",
        "x-internal": true
      }
    },
    "/note/{id}": {
      "post": {
        "operationId": "delete_note",
        "summary": "Delete a note permanently.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/file": {
      "get": {
        "operationId": "read_file",
        "summary": "Read a file from the workspace.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/note": {
      "post": {
        "operationId": "create_note",
        "summary": "Create a new note.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    }
  },
  "security": [
    {
      "key": []
    }
  ]
}
